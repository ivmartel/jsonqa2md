{
    "plugins": ["plugins/markdown"],
    "markdown": {
      "idInHeadings": true
    },
    "opts": {
      "recurse": true,
      "readme": "readme.md",
      "destination": "build/doc",
      "template": "node_modules/clean-jsdoc-theme/dist",
      "tutorials": "resources/doc/tutorials",
      "package": "package.json",
      "siteName": "jsonqa2md doc",
      "sectionOrder": [
        "Tutorials",
        "Namespaces",
        "Classes",
        "Externals",
        "Modules"
      ],
      "menu": [
        { "id": "home" },
        {
          "id": "github",
          "title": "github",
          "link": "https://github.com/ivmartel/jsonqa2md",
          "target": "_blank"
        },
        { "id": "source" }
      ],
      "customCss": "ul {list-style-type: disc !important;} ul ul {list-style-type: circle !important;}"
    }
}
